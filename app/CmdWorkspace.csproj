<Project Sdk="Microsoft.NET.Sdk">

  <!-- New app (Phase R rebuild). Same build settings as the version that built and ran on the user's PC (.NET SDK 10, Windows 11, x64). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CmdWorkspace</RootNamespace>
    <AssemblyName>CmdWorkspace</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon-dark.ico</ApplicationIcon>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The terminal page and the downloaded xterm.js files are copied next to the program. -->
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- App icons: icon-dark.ico is the exe icon. The window icon switches with the theme (MainWindow.ApplyWindowIcon). -->
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
